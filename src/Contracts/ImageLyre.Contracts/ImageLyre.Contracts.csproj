    -->
    <PackageReference Include="Cangming.Platform.Contracts" />
  </ItemGroup>

  <!--
    本工程不引用 Avalonia、AtomUI、SkiaSharp 或任何机制包：
    验收 E 会检查这一点，加引用前先改 DESIGN-0001 并说明理由。
  -->

</Project>
