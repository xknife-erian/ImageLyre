<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 固定方向：ImageLyre.Contracts → ImageLyre.Domains，反向引用一律禁止（ADR-0001 §2.4）。 -->
    <ProjectReference Include="..\ImageLyre.Domains\ImageLyre.Domains.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      借用契约：IPlatformCapabilities 与 IPerformanceMonitor 来自 cangming 的契约库，
