<Solution>
  <!--
    唯一构建入口（DESIGN-0001 §2.1 约束 10）：dotnet build src/ImageLyre.slnx。
    测试工程在 ../tests/ 下，同样挂在本入口里：构建一条命令，测试按工程单独执行。
    目录按职责分：App 放进程入口与启动链；Infrastructure 放共享库，其中 Contracts 子目录专放契约与领域，
    边界因此路径可读；Plugins 下分 Modules 与 Features 两类。删除工程时同步摘除这里的条目。
  -->
  <Folder Name="/App/">
    <Project Path="App/ImageLyre.App/ImageLyre.App.csproj" />
    <Project Path="App/ImageLyre.Bootstrap/ImageLyre.Bootstrap.csproj" />
    <Project Path="App/ImageLyre.Presentation.Desktop/ImageLyre.Presentation.Desktop.csproj" />
  </Folder>
  <Folder Name="/Infrastructure/Contracts/">
    <Project Path="Infrastructure/Contracts/ImageLyre.Domains/ImageLyre.Domains.csproj" />
    <Project Path="Infrastructure/Contracts/ImageLyre.Contracts/ImageLyre.Contracts.csproj" />
    <Project Path="Infrastructure/Contracts/ImageLyre.Shell.Contracts/ImageLyre.Shell.Contracts.csproj" />
  </Folder>
  <Folder Name="/Infrastructure/">
    <Project Path="Infrastructure/ImageLyre.Shell.Attachments/ImageLyre.Shell.Attachments.csproj" />
    <Project Path="Infrastructure/ImageLyre.Localization/ImageLyre.Localization.csproj" />
    <Project Path="Infrastructure/ImageLyre.Shell.Menus/ImageLyre.Shell.Menus.csproj" />
  </Folder>
  <Folder Name="/Plugins/Modules/">
    <Project Path="Plugins/Modules/ImageLyre.Module.Shell/ImageLyre.Module.Shell.csproj" />
    <Project Path="Plugins/Modules/ImageLyre.Module.Platform/ImageLyre.Module.Platform.csproj" />
    <Project Path="Plugins/Modules/ImageLyre.Module.Performance/ImageLyre.Module.Performance.csproj" />
    <Project Path="Plugins/Modules/ImageLyre.Module.Broken/ImageLyre.Module.Broken.csproj" />
  </Folder>
  <Folder Name="/Plugins/Features/">
    <Project Path="Plugins/Features/ImageLyre.Feature.Diagnostics/ImageLyre.Feature.Diagnostics.csproj" />
    <Project Path="Plugins/Features/ImageLyre.Feature.About/ImageLyre.Feature.About.csproj" />
  </Folder>
  <Folder Name="/Tests/">
    <Project Path="../tests/UnitTest.ImageLyre.App/UnitTest.ImageLyre.App.csproj" />
    <Project Path="../tests/UnitTest.ImageLyre.Localization/UnitTest.ImageLyre.Localization.csproj" />
    <Project Path="../tests/UnitTest.ImageLyre.Bootstrap/UnitTest.ImageLyre.Bootstrap.csproj" />
    <Project Path="../tests/UnitTest.ImageLyre.Module.Shell/UnitTest.ImageLyre.Module.Shell.csproj" />
    <Project Path="../tests/UnitTest.ImageLyre.Capabilities/UnitTest.ImageLyre.Capabilities.csproj" />
    <Project Path="../tests/UnitTest.ImageLyre.Shell.Menus/UnitTest.ImageLyre.Shell.Menus.csproj" />
    <Project Path="../tests/UnitTest.ImageLyre.Feature.About/UnitTest.ImageLyre.Feature.About.csproj" />
    <Project Path="../tests/UnitTest.ImageLyre.Presentation.Desktop/UnitTest.ImageLyre.Presentation.Desktop.csproj" />
  </Folder>
</Solution>
