{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "ImageLyre（桌面）": {
      "commandName": "Project"
    },
    "ImageLyre --version": {
      "commandName": "Project",
      "commandLineArgs": "--version"
    },
    "ImageLyre --plugins": {
      "commandName": "Project",
      "commandLineArgs": "--plugins"
    },
    "ImageLyre --help": {
      "commandName": "Project",
      "commandLineArgs": "--help"
    },
    "ImageLyre 未知参数（退出码 2）": {
      "commandName": "Project",
      "commandLineArgs": "--bogus"
    },
    "ImageLyre 桌面冒烟（自动关闭）": {
      "commandName": "Project",
      "environmentVariables": {
        "LYRE_SMOKE_CLOSE_MS": "1500"
      }
    },
    "ImageLyre 菜单冒烟（展开子菜单后关闭）": {
      "commandName": "Project",
      "environmentVariables": {
        "LYRE_SMOKE_OPEN_MENU": "1",
        "LYRE_SMOKE_CLOSE_MS": "1500"
      }
    }
  }
}
