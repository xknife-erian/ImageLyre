<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 进程入口带窗口，因此是 WinExe；目标框架、可空与警告即错误由根 Directory.Build.props 提供。 -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 桌面 UI 路线：Avalonia 承载生命周期与基础控件，AtomUI 提供欢迎窗口的控件与主题。 -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="AtomUI.Desktop.Controls" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CLI 宿主直接读取插件管理器、PluginInfo 与 IPicoFeatures 标记接口，因此显式声明机制包依赖；
      日志抽象用于最小 stderr 日志工厂，避免只靠 Bootstrap 的传递引用。
    -->
    <PackageReference Include="Cangming.PicoPlugins" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 启动链在 Bootstrap，本地化实现在 Localization，契约提供 ILocalizationService 与 ILocalizationSource。 -->
    <ProjectReference Include="..\..\Bootstrap\ImageLyre.Bootstrap\ImageLyre.Bootstrap.csproj" />
    <ProjectReference Include="..\..\Infrastructure\ImageLyre.Localization\ImageLyre.Localization.csproj" />
    <ProjectReference Include="..\..\Contracts\ImageLyre.Contracts\ImageLyre.Contracts.csproj" />
  </ItemGroup>

  <!--
    插件产物到达运行时的唯一形式：一条通配工程引用，把 src/Plugins/**/*.csproj 纳入构建顺序但不参与编译引用。
    按名字的插件 ProjectReference 一律禁止，验收 E 检查的就是这里的按名引用数为 0；
    新增插件只增工程目录，不改本文件。
    退化触发条件：若构建后 App 输出目录不出现匹配到的插件 dll，改在仓库根 Directory.Build.targets 写仓库级复制目标，
    仍不把插件工程按名字写进本文件；届时把实际机制回写 DESIGN-0001 §3.7。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Plugins\**\*.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <!-- ponytail: 通配只复制插件主程序集，不复制插件的私有依赖；G4 接入装包与依赖清单时补依赖收集。 -->
    <!-- ponytail: 复制是增量的，PreserveNewest 不会清理已删插件的旧 dll；删除插件前必须先 dotnet clean。 -->
    <!-- ponytail: 空工程会被扫到但没有 [Plugin] 类型，因此不计数；T14 接入真实插件后这条由真实插件覆盖。 -->
  </ItemGroup>

  <!--
    本工程不引用 ImageLyre.Shell.Contracts（尚未建立）、ImageLyre.Shell.Attachments 或任何按名字的插件工程：
    主窗体由壳插件产出，插件产物只走上一条通配引用。
  -->

</Project>
