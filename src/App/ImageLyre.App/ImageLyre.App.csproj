<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 进程入口带窗口，因此是 WinExe；目标框架、可空与警告即错误由根 Directory.Build.props 提供。 -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      桌面 UI 路线：Avalonia 承载生命周期与基础控件，AtomUI 桌面控件包提供 UseAtomUI 与平台探测；
      欢迎窗控件与 Ant Design 设计语言随 Presentation 工程进入运行时，本工程不直接引用那两个主题包。
    -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="AtomUI.Desktop.Controls" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CLI 宿主直接读取插件管理器、PluginInfo 与 IPicoFeatures 标记接口，因此显式声明机制包依赖；
      日志抽象用于最小 stderr 日志工厂，避免只靠 Bootstrap 的传递引用。
    -->
    <PackageReference Include="Cangming.PicoPlugins" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      启动链与桌面入口：CLI 直接使用 Bootstrap 的 Host 构建器与 HostPlan；桌面分支只转交 Presentation.Desktop，
      欢迎窗、槽位、取壳与 PresentationPlan 都在 L5 工程里。
    -->
    <ProjectReference Include="..\ImageLyre.Bootstrap\ImageLyre.Bootstrap.csproj" />
    <ProjectReference Include="..\ImageLyre.Presentation.Desktop\ImageLyre.Presentation.Desktop.csproj" />
    <ProjectReference Include="..\..\Infrastructure\ImageLyre.Localization\ImageLyre.Localization.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Contracts\ImageLyre.Contracts\ImageLyre.Contracts.csproj" />
  </ItemGroup>

  <!--
    插件产物到达运行时的唯一形式：一条通配工程引用，把 src/Plugins/**/*.csproj 纳入构建顺序但不参与编译引用。
    按名字的插件 ProjectReference 一律禁止，验收 E 检查的就是这里的按名引用数为 0；新增插件只增工程目录，不改本文件。
    这条引用只带来插件主程序集，插件自己的依赖由下面 CopyPluginOutputs 目标从各插件输出目录归并。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Plugins\**\*.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <!-- ponytail: 复制是增量的，PreserveNewest 不会清理已删插件的旧 dll；删除插件前必须先 dotnet clean。 -->
    <!-- ponytail: 空工程会被扫到但没有 [Plugin] 类型，因此不计数；T14 接入真实插件后这条由真实插件覆盖。 -->
  </ItemGroup>

  <!--
    插件依赖归并：见仓库根的 PluginOutputMerge.targets，宿主与它的测试工程共用同一份目标。
  -->
  <Import Project="..\..\..\PluginOutputMerge.targets" />

  <!--
    本工程不按名字引用任何插件工程，也不为插件依赖做编译引用：
    主窗体由壳插件产出，插件与它的依赖都只经上面两条机制进入输出目录。
  -->

</Project>
