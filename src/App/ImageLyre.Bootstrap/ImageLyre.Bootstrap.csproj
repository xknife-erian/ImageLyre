<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 机制基座：扫描、容器注册、插件管理器与日志门面都来自这一组包。 -->
    <PackageReference Include="Cangming.PicoPlugins" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件失败分类是纯函数，测试工程直接验证 Degraded 判定，不启动真实插件管理器。 -->
    <InternalsVisibleTo Include="UnitTest.ImageLyre.Bootstrap" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只依赖契约，不按名字引用任何插件工程（DESIGN-0001 §3.2）。 -->
    <ProjectReference Include="..\..\Infrastructure\Contracts\ImageLyre.Contracts\ImageLyre.Contracts.csproj" />
  </ItemGroup>

  <!--
    本工程不引用 Avalonia、AtomUI、SkiaSharp 或任何 ImageLyre.Module.* / ImageLyre.Feature.* 工程：
    它是无界面的启动链，验收 E 会检查这一点，加引用前先改 DESIGN-0001 并说明理由。
  -->

</Project>
