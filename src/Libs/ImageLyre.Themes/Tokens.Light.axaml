<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 亮 30：值取自 color-tokens.md 1.3，键名由 ADR-0009 §2.1 规定 -->
    <Color x:Key="Lyre.Surface.Window">#F5F6F8</Color>
    <Color x:Key="Lyre.Surface.Panel">#FFFFFF</Color>
    <Color x:Key="Lyre.Surface.Canvas">#E8EAED</Color>
    <Color x:Key="Lyre.Surface.Input">#FFFFFF</Color>
    <Color x:Key="Lyre.Surface.Hover">#EAEDF0</Color>
    <Color x:Key="Lyre.Line.Divider">#DFE2E6</Color>
    <Color x:Key="Lyre.Line.Border">#C2C7CD</Color>
    <Color x:Key="Lyre.Line.Focus">#B83A24</Color>
    <Color x:Key="Lyre.Text.T1">#141619</Color>
    <Color x:Key="Lyre.Text.T2">#4C5259</Color>
    <Color x:Key="Lyre.Text.T3">#6A717A</Color>
    <Color x:Key="Lyre.Text.Disabled">#7B828A</Color>
    <Color x:Key="Lyre.Signal.Active">#B83A24</Color>
    <Color x:Key="Lyre.Signal.Running">#B83A24</Color>
    <Color x:Key="Lyre.State.Selected.Bg">#E2E6EA</Color>
    <Color x:Key="Lyre.State.Disabled.Bg">#F1F3F5</Color>
    <Color x:Key="Lyre.Signal.Warning.Background">#F6E7E5</Color>
    <Color x:Key="Lyre.Signal.Warning.Line">#B83A24</Color>
</ResourceDictionary>
