{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagelyre.dev/schema/lyre.roi.v1.json",
  "title": "lyre.roi/v1",
  "type": "object",
  "required": [
    "schema",
    "rois"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "lyre.roi/v1"
    },
    "rois": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "roiId",
          "type"
        ],
        "properties": {
          "roiId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "rectangle",
              "polygon",
              "ellipse",
              "freehand",
              "point",
              "line",
              "composite"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "center": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "radii": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "angle": {
            "type": "number"
          },
          "z": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "t": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "and",
              "or",
              "xor"
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ellipse"
                }
              }
            },
            "then": {
              "required": [
                "center",
                "radii",
                "angle"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "rectangle"
                }
              }
            },
            "then": {
              "required": [
                "points"
              ],
              "properties": {
                "points": {
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "polygon"
                }
              }
            },
            "then": {
              "required": [
                "points"
              ],
              "properties": {
                "points": {
                  "minItems": 3
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "freehand"
                }
              }
            },
            "then": {
              "required": [
                "points"
              ],
              "properties": {
                "points": {
                  "minItems": 3
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "line"
                }
              }
            },
            "then": {
              "required": [
                "points"
              ],
              "properties": {
                "points": {
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "point"
                }
              }
            },
            "then": {
              "required": [
                "points"
              ],
              "properties": {
                "points": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "composite"
                }
              }
            },
            "then": {
              "required": [
                "operator",
                "children"
              ],
              "properties": {
                "children": {
                  "minItems": 2
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
