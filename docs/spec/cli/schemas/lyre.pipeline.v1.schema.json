{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagelyre.dev/schema/lyre.pipeline.v1.json",
  "title": "lyre.pipeline/v1",
  "type": "object",
  "required": [
    "schema",
    "steps"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "lyre.pipeline/v1"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "args"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "onError": {
            "type": "string",
            "enum": [
              "stop",
              "continue"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
