{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagelyre.dev/schema/lyre.sidecar.v1.json",
  "title": "lyre.sidecar/v1",
  "type": "object",
  "required": [
    "schema",
    "toolVersion",
    "buildHash",
    "runtime",
    "imagejBaseline",
    "inputSha256",
    "calibration",
    "roi",
    "plugins",
    "threshold",
    "quality",
    "options",
    "outputCsv",
    "timestamp"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "lyre.sidecar/v1"
    },
    "toolVersion": {
      "type": "string"
    },
    "buildHash": {
      "type": "string"
    },
    "runtime": {
      "type": "string"
    },
    "imagejBaseline": {
      "type": "string"
    },
    "inputSha256": {
      "type": "string"
    },
    "calibration": {
      "type": "object"
    },
    "roi": {
      "type": "object",
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "roiIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "required": [
        "measurements",
        "decimals",
        "nanPolicy",
        "threads"
      ],
      "properties": {
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decimals": {
          "type": "integer",
          "minimum": 0
        },
        "nanPolicy": {
          "type": "string"
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "slice": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "outputCsv": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "planHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "quality": {
      "type": [
        "object",
        "null"
      ]
    },
    "stableFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "trust": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "threshold": {
      "type": [
        "object",
        "null"
      ]
    },
    "artifactHash": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
