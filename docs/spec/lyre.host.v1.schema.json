{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagelyre.dev/schema/lyre.host.v1.json",
  "title": "lyre.host/v1",
  "type": "object",
  "required": ["schema", "hostVersion", "protocolVersion", "supportedFormats", "maxWorkers"],
  "properties": {
    "schema": { "type": "string", "const": "lyre.host/v1" },
