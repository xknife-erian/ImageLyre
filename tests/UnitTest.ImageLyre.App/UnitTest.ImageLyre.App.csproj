<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 的测试项目本身就是可执行程序，dotnet test 走 global.json 指定的 MTP runner。 -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App\ImageLyre.App\ImageLyre.App.csproj" />
  </ItemGroup>

  <!--
    测试进程同样以「插件就在输出目录旁边」为前提启动 Bootstrap，因此与宿主导入同一份归并目标，
    否则插件清单用例会因为插件依赖缺失而拿不到插件。
  -->
  <Import Project="..\..\PluginOutputMerge.targets" />

</Project>
