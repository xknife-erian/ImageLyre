<Project>

  <!--
    插件依赖归并：插件在自己的 bin 下会产出全部运行时依赖（机制包、契约、UI 路线包），
    插件主程序集由宿主工程里那条 src/Plugins/**/*.csproj 通配引用带进输出目录，
    其余 dll 由本目标按插件目录逐个取顶层文件复制过来。宿主工程与它的测试工程都导入本文件，
    因为测试进程同样要以「插件就在输出目录旁边」为前提启动 Bootstrap。

    只取一层 *.dll，不递归进 runtimes/ 之类的子目录，避免把原生库拍平到输出根；
    路径以本文件所在目录为基准，因此与导入方工程的位置无关。
  -->
  <Target Name="MergePluginOutputs" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)src\Plugins')">
    <ItemGroup>
      <PluginOutputDll Include="$(MSBuildThisFileDirectory)src\Plugins\**\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutputDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
